{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__update_pull_request_branch",
      "mcp__github__add_issue_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__pull_request_review_write",
      "mcp__github__issue_write",
      "mcp__github__sub_issue_write",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files",
      "mcp__github__delete_file",
      "Bash(gh pr create *)",
      "Bash(gh pr new *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue create *)",
      "Bash(gh issue new *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git merge *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(git config *hooksPath*)",
      "Bash(git config *hook.*)",
      "Bash(git config --global *)",
      "Bash(git -c *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr new *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh pr close *)",
      "PowerShell(gh pr reopen *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue new *)",
      "PowerShell(gh issue edit *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git merge *--no-verify*)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(git config *hooksPath*)",
      "PowerShell(git config *hook.*)",
      "PowerShell(git config --global *)",
      "PowerShell(git -c core.hooksPath*)",
      "PowerShell(git -c hook.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/attribution-guard/session-start.sh\"; [ ! -f \"$f\" ] || sh \"$f\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Write|Edit|MultiEdit|NotebookEdit|mcp__.*([Gg]it[Hh]ub|[Aa]do|[Aa]zure|[Dd]ev[Oo]ps).*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "c=$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --git-common-dir 2>/dev/null) && d=$(cd \"$CLAUDE_PROJECT_DIR\" && cd \"$c\" && pwd)/attribution-guard && [ -f \"$d/claude-pretooluse.sh\" ] && f=\"$d/claude-pretooluse.sh\" || f=\"$CLAUDE_PROJECT_DIR/tools/attribution-guard/claude-pretooluse.sh\"; [ ! -f \"$f\" ] || sh \"$f\" --strict"
          }
        ]
      }
    ]
  }
}
