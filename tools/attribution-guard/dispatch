#!/bin/sh
# Global hooks dispatcher for `git config --global core.hooksPath <dir>` (Git < 2.54 only).
# Installed under every hook name. A global core.hooksPath makes git ignore .git/hooks, so after
# the attribution guard this runs the repository's own hook of the same name.
set -u
name=$(basename "$0")
here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

stdin_copy=
case $name in
    pre-push | pre-receive | post-rewrite | reference-transaction | post-receive)
        # These hooks get data on stdin; keep a copy so the repo's hook can read it too.
        stdin_copy=$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/githook.$$")
        cat >"$stdin_copy"
        trap 'rm -f "$stdin_copy"' EXIT ;;
esac

case $name in
    commit-msg) sh "$here/attribution-guard.sh" commit-msg "$@" || exit $? ;;
    pre-push) sh "$here/attribution-guard.sh" pre-push "$@" <"$stdin_copy" || exit $? ;;
esac

repo_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/$name"
if [ -f "$repo_hook" ] && [ -x "$repo_hook" ]; then
    if [ -n "$stdin_copy" ]; then "$repo_hook" "$@" <"$stdin_copy"; else "$repo_hook" "$@"; fi
    exit $?
fi
exit 0
