      "Bash(gh pr checks *)",
      "Bash(gh pr status)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh auth status)",

      "Bash(az account show)",
      "Bash(az account list *)",
