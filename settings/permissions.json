{
  "$comment": "Read-only inspection commands, merged by hand into ~/.claude/settings.json permissions.allow (the installer does not apply this file). Nothing here mutates state or runs code from the checked-out repository; anything that can (apply, delete, push, set, create, upgrade, build, test) stays out on purpose. Build and test runners live in permissions-trusted-repo.json.",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git fetch *)",
      "Bash(git ls-files *)",
