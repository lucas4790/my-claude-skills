// VS Code user settings for using this marketplace with GitHub Copilot Chat (VS Code 1.110+).
// Merge by hand into your user settings.json (Ctrl+Shift+P -> "Preferences: Open User Settings (JSON)").
// Plugins themselves are installed by install-copilot.sh / install-copilot.ps1 (Copilot CLI);
// VS Code discovers those automatically. Setting names follow
// https://code.visualstudio.com/docs/agent-customization/agent-plugins and are still marked
// Experimental/Preview there, so check them against your VS Code version.
{
  // Agent plugins (skills, agents, hooks, MCP from plugins). May be locked by an org policy
  // (ChatPluginsEnabled); "Developer: Policy Diagnostics" shows which policies apply.
  "chat.plugins.enabled": true,

  // Lets you browse/install from this marketplace in the Extensions view (@agentPlugins).
  // Do NOT copy this array verbatim: its default differs between VS Code versions. Use the
  // Settings UI -> "chat.plugins.marketplaces" -> Add Item -> lucas4790/my-claude-skills,
  // which keeps the defaults. Plugins installed through Copilot CLI show up even without it.
  // "chat.plugins.marketplaces": ["<keep the defaults>", "lucas4790/my-claude-skills"],

  // Plugin updates are checked every 24 h only when extension auto-update is on.
  "extensions.autoUpdate": true,

  // Skills (on by default since 1.109) and the instruction files the repos use.
  "chat.useAgentSkills": true,
  "chat.useAgentsMdFile": true,
  "chat.useClaudeMdFile": true,

  // Keep Claude Code user hooks (the SessionStart plugin updater registered by install.sh)
  // out of VS Code's own agent; they still run in Claude Code and in VS Code's Claude session target.
  "chat.useClaudeHooks": false,

  // Never add an AI co-author trailer to commits made from VS Code (docs/ATTRIBUTION.md).
  "git.addAICoAuthor": "off"

  // Optional: auto-approve a subset of the read-only commands in settings/permissions.json. An entry here
  // approves every flag of a matching command, and a regex sees the command text as written, so a quoted or
  // escaped flag (--kube"config") gets past a lookahead that names the flag. These regexes therefore reject
  // any quote or backslash, and the flags that run a program, send credentials elsewhere or write a file:
  // git --output; kubectl/helm --kubeconfig; kubectl --server, -s (also in a group such as -As), --cache-dir
  // and --profile; helm --kube-apiserver, --kube-token, --post-renderer, --output-dir, --repository-*,
  // --registry-config and --dependency-update. git diff/log/show/blame have no rule in permissions.json
  // (Claude Code's built-in read-only check covers them); here they rely on the lookahead. git branch only
  // lists, terraform fmt only checks, az only shows or lists in the groups permissions.json names (no
  // `az keyvault secret show`, no `... keys list`), and terraform plan and helm template stay out. Shell
  // redirection (> file) is not covered. VS Code's default deny rules stay active; do not set
  // chat.tools.terminal.ignoreDefaultAutoApproveRules.
  // , "chat.tools.terminal.autoApprove": {
  //     "/^git status\\b/": true,
  //     "/^git branch( -a| --show-current)?$/": true,
  //     "/^git (diff|log|show|blame)\\b(?!.*(--out|['\"\\\\]))/": true,
  //     "/^kubectl (get|describe|logs|top|explain|version|api-resources)\\b(?!.*(--(kubeconfig|server|cache-dir|profile)| -[A-Za-z]*s|['\"\\\\]))/": true,
  //     "/^helm (list|status|history|lint|version)\\b(?!.*(--(kubeconfig|kube-apiserver|kube-token|post-renderer|output-dir|repository-|registry-config|dependency-update)|['\"\\\\]))/": true,
  //     "/^terraform (validate|version)\\b/": true,
  //     "/^terraform fmt -check( -diff)?( -recursive)?$/": true,
  //     "/^az (account|group|resource|aks|aks nodepool|keyvault|identity|acr|acr repository|network vnet|role assignment|role definition|monitor metrics|pipelines|pipelines runs|repos|repos pr|boards work-item) (show|list)(\\s|$)/": true
  //   }
}
